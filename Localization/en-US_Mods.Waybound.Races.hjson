Human: {
	Name: Human
	Info:
		'''
		The most common race. 
		Humans mostly known as an adaptable race who can 
		easily avoid conflicts, but when they do resort to them, 
		they persist in them just as long. 
		Thez have no downsides, although something lingers.
		'''
	Pozitiv: Balanced.
	Negativ: Not able to make offerings to the idols.
	ShortNegativ: Not indol
}

Desfo: {
	Name: Desfo
	Info:
		'''
		The greediest race in the world
		who worship the god Ra. 
		Very little is known about them. Their relationships
		with other races are infamous.
		They are definitely hiding something..
		'''
	Pozitiv:
		'''
		The player starts with the Avarice Bag.
		The bag is a portable transmutation craft station
		that devours the items but gives something in return
		'''
	Negativ: Unable to use standart crafting.
	ShortNegativ: Not indol
}

Dwarf: {
	Name: Dwarf
	Info:
		'''
		The most hardworking and conflict-averse race.
		They don’t lie, but they often speak in riddles. 
		Legends say that they were born in mines.
		Vikings are their most hated enemies.
		'''
	Pozitiv:
		'''
		Dwarfes' powers are increased while underground.
		They can spawn a ghosty platforms in the air. 
		Spatial manipulations. Higher jumps.
		'''
	Negativ:
		'''
		Dwarfes' powers are weaked at the surface.
		They are too heavy to wear wings. 
		Slower speed.
		'''
	ShortNegativ: Not support wing
}

Lihzard: {
	Name: Lihzard
	Info:
		'''
		Those who stay in the shadows answer for nothing; 
		those who stand accountable have everything to lose.
		Insanely smart and inherently evil.
		'''
	Pozitiv:
		'''
		Born to be magicians, born to deal with dilemmas.
		More maximum mana.
		Player can choose 2 out of 4 buffs 
		that dynamically change during the game.
		'''
	Negativ:
		'''
		Slow race that is unable to make dashes.
		Melee damage is absurdly low
		'''
	ShortNegativ: Not support dash
}

Viking: {
	Name: Viking
	Info:
		'''
		Unforgivable race.
		Mostly, they are using
		their brute strength to reach their goals.
		Known as a stupid race, who filled with hatred.
		Dwarfes are their most hated enemies.
		'''
	Pozitiv:
		'''
		Too stupid to have more than 60 mana.
		Berserker's Rage that gives unique effects depending
		on what stage of game player currently is.
		Melee damage is permanently increased.  
		'''
	Negativ:
		'''
		Can not use potions.
		Unable to use regeneration accessories.
		'''
	ShortNegativ: Not support craft
}
